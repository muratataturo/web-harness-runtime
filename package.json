{
  "name": "web-harness-runtime",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Pi + OpenRouter + agent-browser autonomous research task runtime",
  "bin": {
    "web-harness": "dist/cli.js"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "build": "node scripts/build-artifact.mjs && tsc",
    "start": "node dist/cli.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "security:check": "node --import tsx --test test/net-policy.test.ts test/security-boundary.test.ts test/html-reader.test.ts test/sandbox.test.ts test/codex-sandbox.test.ts test/presentation.test.ts",
    "browser:install": "agent-browser install",
    "web": "node --import tsx src/cli.ts web",
    "test:ui": "node --import tsx scripts/ui-smoke.mjs",
    "test:image": "sh infra/openshell/smoke.sh",
    "format": "prettier --write src web test scripts examples benchmarks config .github",
    "format:check": "prettier --check src web test scripts examples benchmarks config .github",
    "eval:families": "node scripts/eval-families.mjs",
    "eval:day-out": "node scripts/eval-day-out.mjs",
    "eval:harness": "npm run build && node scripts/eval-harness-quality.mjs",
    "eval:ux": "node --import tsx scripts/eval-ux-loop.mjs",
    "learning:build": "npm run build && node dist/cli.js learning build",
    "sandbox:local": "node scripts/local-openshell.mjs",
    "chat": "node --import tsx src/cli.ts chat",
    "mcp": "node dist/cli.js mcp",
    "test:chat": "node --import tsx scripts/chat-smoke.mjs",
    "test:chat:runtime": "npm run build && node --import tsx scripts/chat-runtime-e2e.mjs",
    "test:chat:live": "npm run build && node --import tsx scripts/chat-runtime-e2e.mjs --live --local-gateway",
    "release:verify": "npm run check && npm test && npm run test:chat && npm run test:chat:runtime && npm run test:chat:live && npm run package:cli",
    "clients:config": "node dist/cli.js clients",
    "opencode:client": "node scripts/opencode-client.mjs",
    "package:cli": "npm run build && node scripts/package-cli.mjs",
    "release:check": "node scripts/release-preflight.mjs",
    "docs:screenshots": "node --import tsx scripts/capture-docs.mjs",
    "eval:visual": "npm run build && node --import tsx scripts/eval-visual-artifact.mjs && node scripts/eval-journey-moments.mjs && node scripts/eval-answer-contrast.mjs && node scripts/eval-proposal-comparison.mjs && node scripts/eval-cafe-itinerary.mjs",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "test:itinerary:live": "npm run build && node scripts/itinerary-live-e2e.mjs --live"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@mapbox/vector-tile": "3.0.0",
    "@napi-rs/canvas": "0.1.100",
    "@sinclair/typebox": "0.34.52",
    "@stylexjs/stylex": "0.19.2",
    "agent-browser": "0.41.2",
    "cheerio": "1.2.0",
    "commander": "14.0.3",
    "dotenv": "17.4.2",
    "leaflet": "1.9.4",
    "pbf": "5.1.2",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "1.6.2"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/*.js",
    "web/*.html",
    "web/*.js",
    "web/*.css",
    "config/*.json",
    "examples/*.json",
    "docs/usage.md",
    "docs/security-boundary-design.md",
    "docs/security-boundary-results.md",
    "docs/chat-runtime-acceptance.md",
    "docs/delivery-results.md",
    "docs/evidence/codex-strata.json",
    "docs/evidence/recruit-theme-results.json",
    "docs/evidence/delivery-results.json",
    "docs/evidence/security-boundary-results.json",
    "docs/evidence/chat-runtime-results.json",
    "scripts/opencode-client.mjs",
    "benchmarks/*.json",
    "infra/strata/*.py",
    "docs/strata-colab.md",
    "docs/evidence/strata-colab-results.json"
  ]
}

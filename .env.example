# Agent engine: codex (default, ChatGPT sign-in) / claude-code / pi-openrouter / opencode.
# Run codex login, then npm start -- codex-doctor. No OpenAI API key is needed.
# RUNTIME_AGENT=codex
# CODEX_BIN=/absolute/path/to/codex
# CODEX_MODEL=an-available-model-from-codex-doctor

# Required only for RUNTIME_AGENT=pi-openrouter.
OPENROUTER_API_KEY=
# Optional. Must be a currently available, zero-price, tool-capable model.
# OPENROUTER_MODEL=openrouter/free
# RUNTIME_DIR=.runtime

# Optional: use an existing Chrome installation instead of the downloaded browser.
# AGENT_BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Task executor: local (default) or openshell.
# RUNTIME_EXECUTOR=local
# OPENSHELL_GATEWAY=selfhost
# OPENSHELL_IMAGE=web-harness-runtime:local
# OPENSHELL_PROVIDER=wh-pi-router
# OPENSHELL_BIN=/absolute/path/to/openshell
# Codex: dedicated retained account worker; login INSIDE VM using sandbox:local codex-login.
# OPENSHELL_CODEX_SANDBOX=wh-codex
# OPENSHELL_CODEX_IMAGE=web-harness-codex:local

# OpenCode 1.19.5 uses the EXISTING Strata endpoint; no GPU allocation or model fallback.
# Local agent process only; inference stays on the existing Colab GPU.
# OPENCODE_BIN=/private/tmp/strata-opencode/node_modules/.bin/opencode
# OPENCODE_MODEL=strata-colab/qwen3.8-flash-next-iq2_xs
# STRATA_BASE_URL=http://127.0.0.1:18081/v1
# STRATA_KEY_FILE=/absolute/path/outside/repository/strata-api-key
# Alternative: set STRATA_API_KEY in the environment (secret; never commit it).

# Claude Code uses its own subscription login, not ANTHROPIC_API_KEY.
# CLAUDE_BIN=/absolute/path/to/claude
# CLAUDE_MODEL=claude-sonnet-5-5
# Alternative: claude-haiku-5-5

# Shared daemon for Chat / CLI runs / MCP stdio bridge.
# HARNESS_URL=http://127.0.0.1:4311

# Explicit Strata / Colab lifecycle (strata up allocates a GPU; run never does).
# Python >=3.12 + OpenSSH are required on the host. Google login stays with Colab CLI.
# COLAB_BIN=/absolute/path/to/colab
# COLAB_PYTHON=/absolute/path/to/colab-venv/bin/python
# STRATA_PYTHON=python3
# STRATA_STATE_DIR=.runtime/strata-colab
# STRATA_COLAB_SESSION=web-harness-qwen
# STRATA_LOCAL_PORT=18081
# STRATA_REMOTE_PORT=18082
# STRATA_PI_BIN=/absolute/path/to/pi
# Leave STRATA_BASE_URL/STRATA_KEY_FILE/STRATA_API_KEY unset to use managed connection.json.

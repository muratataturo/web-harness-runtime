OPENROUTER_API_KEY=
# Optional. Must be a currently available, zero-price, tool-capable model.
# OPENROUTER_MODEL=openrouter/free
# RUNTIME_DIR=.runtime

# Optional: use an existing Chrome installation instead of the downloaded browser.
# AGENT_BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Task executor: local (default) or openshell.
# RUNTIME_EXECUTOR=local
# OPENSHELL_GATEWAY=selfhost
# OPENSHELL_IMAGE=web-harness-runtime:local
# OPENSHELL_PROVIDER=web-harness-openrouter
